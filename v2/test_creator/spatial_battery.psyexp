        <Param val="item_stim.image = stim_folder + '/' + instructions_loop.thisTrial[&quot;instructions_page&quot;]&amp;#10;&amp;#10;ans_boxes = {}&amp;#10;letters = ('A', 'B', 'C', 'D', 'E', 'F', 'G', 'H')&amp;#10;currently_selected = []&amp;#10;answerPositionX = None&amp;#10;answerPositionY = None&amp;#10;&amp;#10;if instructions_loop.thisTrial['practice_item']:&amp;#10;    &amp;#10;    if type_of_test == 'multiple choice':&amp;#10;&amp;#10;        answerPositionX = instructions_loop.thisTrial['answer_positionPX']&amp;#10;        answerPositionY = instructions_loop.thisTrial['answer_positionPY']&amp;#10;        &amp;#10;        for i in range(len(answerPositionPX)):&amp;#10;            l = letters[i]&amp;#10;            coords = (answerPositionX[i] * scale, answerPositionY[i] * scale)&amp;#10;            coords = (-1 * screen_size[0]/2 * scale + coords[0], screen_size[1]/2 * scale - coords[1]) &amp;#10;            ans_boxes[f'ans_box_{l}'] = coords&amp;#10;            &amp;#10;&amp;#10;        selector_box.pos = [-2000 * scale, 0]&amp;#10;        selector_box.size = [instructions_loop.thisTrial['selector_sizeP'][0] * scale, instructions_loop.thisTrial['selector_sizeP'][1] * scale]&amp;#10;        &amp;#10;&amp;#10;&amp;#10;    elif type_of_test == 'fill in the blank':&amp;#10;        text_entry_box.setPos([instructions_loop.thisTrial[&quot;textbox_pos&quot;][0] * scale, instructions_loop.thisTrial[&quot;textbox_pos&quot;][1] * scale])&amp;#10;        text_entry_box.setSize([float(instructions_loop.thisTrial[&quot;textbox_size&quot;][0] * scale), float(instructions_loop.thisTrial[&quot;textbox_size&quot;][1]) * scale])&amp;#10;        text_entry_box.editable = True&amp;#10;       &amp;#10;    elif type_of_test == 'multiple selection':&amp;#10;        answerPositionPX = instructions_loop.thisTrial['answer_positionPX']&amp;#10;        answerPositionPY = instructions_loop.thisTrial['answer_positionPY']&amp;#10;        &amp;#10;        for i in range(len(answerPositionPX)):&amp;#10;            Pcoords = [answerPositionPX[i] * scale, answerPositionPY[i] * scale]&amp;#10;            Pcoords = [((-1 * screen_size[0]/2) + Pcoords[0]), ((screen_size[1]/2) - Pcoords[1])]&amp;#10;            click_boxes[&quot;click_box&quot; + str(i)].setPos(Pcoords)&amp;#10;            click_boxes[&quot;click_box&quot; + str(i)].setSize([instructions_loop.thisTrial[&quot;selector_sizeP&quot;][0] * scale, instructions_loop.thisTrial[&quot;selector_sizeP&quot;][1] * scale])&amp;#10;            click_boxes[&quot;click_box&quot; + str(i)].setFillColor([1,1,1])&amp;#10;        &amp;#10;&amp;#10;            &amp;#10;mouse_down = False&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
